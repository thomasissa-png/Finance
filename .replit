run = "pip install -r requirements.txt && uvicorn backend.app.main:app --host 0.0.0.0 --port 5000"

[deployment]
deploymentTarget = "cloudrun"
build = ["sh", "-c", "pip install -r requirements.txt && cd frontend && npm install && npm run build"]
run = ["sh", "-c", "uvicorn backend.app.main:app --host 0.0.0.0 --port 5000"]

[[ports]]
localPort = 5000
externalPort = 80
